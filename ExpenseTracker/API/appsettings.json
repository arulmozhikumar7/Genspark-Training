"Serilog": {
  "MinimumLevel": "Information",
  "WriteTo": [
    {
      "Name": "Console"
    },
    {
      "Name": "File",
      "Args": {
        "path": "Logs/log.txt",
        "rollingInterval": "Day"
      }
    },
    {
      "Name": "AzureBlobStorage",
      "Args": {
        "connectionString": "",
        "storageContainerName": "logs",
        "storageFileName": "serilog-{yyyyMMdd}.txt",
        "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] {Message}{NewLine}{Exception}",
        "period": "00:00:10",
        "batchPostingLimit": 50,
        "bypassBlobCreationValidation": true,
        "useUtcTimeZone": true
      }
    }
  ],
  "Enrich": [
    "FromLogContext",
    "WithMachineName",
    "WithThreadId"
  ]
}
,
